node_modules/
.DS_Store

# `npm run build` output, reproducible from source. The two apps ignore their
# own; this is for anything built at the root.
dist/

# `npm pack` writes one of these beside the manifest.
*.tgz

# What `--notes` is pointed at, and what `publish.yml` writes reading the tag
# back. `bin/release.js` refuses a dirty tree, so an untracked file here would
# refuse the release it was written for.
release-notes.md

# Secrets. `.env.example` is a committed template and is not one.
.env
.env.*
!.env.example

# Editor and agent working files. The engineering record they used to hold is in
# `design/internals.md`, which is where a contributor looks for it.
.claude/
CLAUDE.md

# vsce output, built from editor/vscode when someone packages the extension
*.vsix
