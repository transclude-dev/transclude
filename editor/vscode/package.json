{
  "name": "transclude",
  "displayName": "transclude",
  "description": "Diagnostics, hovers and highlighting for transclude .html files",
  "version": "0.1.0",
  "publisher": "transclude",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/transclude-dev/transclude.git",
    "directory": "editor/vscode"
  },
  "keywords": [
    "transclude",
    "html",
    "hypermedia",
    "language-server"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:html"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "npx --yes @vscode/vsce package",
    "publish": "npx --yes @vscode/vsce publish"
  },
  "contributes": {
    "grammars": [
      {
        "scopeName": "transclude.injection",
        "path": "./syntaxes/transclude.injection.json",
        "injectTo": [
          "text.html.basic",
          "text.html.derivative"
        ],
        "embeddedLanguages": {
          "meta.embedded.expression.transclude": "javascript"
        }
      },
      {
        "scopeName": "transclude.directives",
        "path": "./syntaxes/transclude.directives.json",
        "injectTo": [
          "text.html.basic",
          "text.html.derivative"
        ],
        "embeddedLanguages": {
          "meta.embedded.expression.transclude": "javascript"
        }
      }
    ],
    "configuration": {
      "title": "transclude",
      "properties": {
        "transclude.enable": {
          "type": "boolean",
          "default": true,
          "description": "Type check .html files in a transclude project."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
