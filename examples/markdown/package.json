{
  "name": "transclude-example-markdown",
  "private": true,
  "type": "module",
  "description": "Markdown pages. A .md file under routes/ is a page, and the elements in it are rendered on the server.",
  "scripts": {
    "dev": "transclude-dev",
    "build": "transclude-build",
    "start": "transclude-serve",
    "check": "transclude-check",
    "test": "node --test \"test/**/*.test.js\"",
    "preview": "npm run build && npm start",
    "start:worker": "npx wrangler dev",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@transclude/core": "file:../..",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "typescript": "^7.0",
    "vite": "^8.1.5"
  }
}
