node_modules/

# `npm run build` output: prerendered pages, the server bundle, client entries
# and their precompressed twins. All reproducible from source.
dist/

# Generated by `npm run check`, from the compiled routes. An output, so it is
# not committed: tracked, it went stale twice in one day, once because a merge
# invalidated it and nothing was watching. www has always ignored it.
app/transclude-env.d.ts

# Claude Code's working directory.
.claude/

# wrangler's local state for `npm run start:worker`. Regenerated on demand.
.wrangler/

# Secrets. `.env.example` is the committed template and is not one.
.env
.env.*
!.env.example

# The same, for `wrangler dev`.
.dev.vars
