{
  "name": "transclude-example-showcase",
  "private": true,
  "type": "module",
  "description": "Every feature, and the browser checks. Built against the framework beside it.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/.bin/transclude-dev",
    "build": "transclude-build",
    "start": "node --env-file-if-exists=.env node_modules/.bin/transclude-serve",
    "check": "transclude-check",
    "test": "node --test \"test/**/*.test.js\"",
    "preview": "npm run build && npm start",
    "start:bun": "bun node_modules/@transclude/core/bin/serve.bun.js",
    "start:deno": "deno run -A --env-file node_modules/@transclude/core/bin/serve.deno.js",
    "start:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@transclude/core": "file:../.."
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
