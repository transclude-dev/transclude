{
  "name": "@transclude/core",
  "version": "0.18.1",
  "description": "An HTML-first server framework. A page is an .html file, the directory tree is the route table, and any fragment of a page is a URL of its own. Runs on Node, Bun, Deno and workerd, and ships no client JavaScript by default.",
  "keywords": [
    "html",
    "hypermedia",
    "fragments",
    "ssr",
    "server-side-rendering",
    "framework",
    "custom-elements",
    "declarative-shadow-dom",
    "htmx",
    "hono",
    "vite"
  ],
  "homepage": "https://transclude.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transclude-dev/transclude.git"
  },
  "bugs": {
    "url": "https://github.com/transclude-dev/transclude/issues"
  },
  "license": "MIT",
  "author": "Joe Dakroub",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "transclude-build": "./bin/build.js",
    "transclude-check": "./bin/check.js",
    "transclude-dev": "./bin/dev.js",
    "transclude-serve": "./bin/serve.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/plugin.d.ts",
      "default": "./src/plugin.js"
    },
    "./app": {
      "types": "./dist/types/app.d.ts",
      "default": "./src/app.js"
    },
    "./compiler": {
      "types": "./dist/types/compiler/index.d.ts",
      "default": "./src/compiler/index.js"
    },
    "./cookies": {
      "types": "./dist/types/cookies.d.ts",
      "default": "./src/cookies.js"
    },
    "./document": {
      "types": "./dist/types/document.d.ts",
      "default": "./src/document.js"
    },
    "./production": {
      "types": "./dist/types/production.d.ts",
      "default": "./src/production.js"
    },
    "./routes": {
      "types": "./dist/types/routes.d.ts",
      "default": "./src/routes.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime/index.d.ts",
      "default": "./src/runtime/index.js"
    },
    "./serve.bun": "./bin/serve.bun.js",
    "./serve.deno": "./bin/serve.deno.js",
    "./typecheck": {
      "types": "./dist/types/typecheck.d.ts",
      "default": "./src/typecheck.js"
    },
    "./worker": {
      "types": "./dist/types/worker.d.ts",
      "default": "./src/worker.js"
    }
  },
  "files": [
    "LICENSE",
    "bin",
    "dist/types",
    "editor/server.js",
    "skills",
    "src"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "types": "tsc -p tsconfig.types.json",
    "prepack": "npm run types",
    "crap": "node scripts/crap.js",
    "test:examples": "npm test --prefix examples/showcase && npm test --prefix examples/todomvc && npm test --prefix examples/dungeon && npm test --prefix examples/lite-brite && npm test --prefix examples/blog && npm test --prefix examples/search && npm test --prefix examples/htmx && npm test --prefix examples/includes && npm test --prefix examples/auth && npm test --prefix examples/live && npm test --prefix examples/elements && npm test --prefix examples/markdown && npm test --prefix examples/atlas",
    "test:www": "npm test --prefix www",
    "showcase": "npm run dev --prefix examples/showcase",
    "todomvc": "npm run dev --prefix examples/todomvc",
    "lite-brite": "npm run dev --prefix examples/lite-brite",
    "dungeon": "npm run dev --prefix examples/dungeon",
    "blog": "npm run dev --prefix examples/blog",
    "search": "npm run dev --prefix examples/search",
    "htmx": "npm run dev --prefix examples/htmx",
    "includes": "npm run dev --prefix examples/includes",
    "auth": "npm run dev --prefix examples/auth",
    "live": "npm run dev --prefix examples/live",
    "elements": "npm run dev --prefix examples/elements",
    "markdown": "npm run dev --prefix examples/markdown",
    "atlas": "npm run dev --prefix examples/atlas",
    "www": "npm run dev --prefix www",
    "check:src": "tsc -p tsconfig.src.json",
    "release": "node bin/release.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "acorn": "^8.18.0",
    "hono": "^4.12.32",
    "jsep": "^1.4.0",
    "parse5": "^8.0.1"
  },
  "peerDependencies": {
    "typescript": "^7.0",
    "vite": "^8"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "7.0.2",
    "vite": "^8.1.5"
  }
}
