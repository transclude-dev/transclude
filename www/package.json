{
  "name": "transclude-docs",
  "private": true,
  "type": "module",
  "description": "The documentation site. An app built against the framework beside it.",
  "scripts": {
    "predev": "node scripts/write-version.js",
    "dev": "transclude-dev",
    "prebuild": "node scripts/write-version.js",
    "build": "transclude-build",
    "start": "transclude-serve",
    "precheck": "node scripts/write-version.js",
    "check": "transclude-check",
    "test": "node --test \"test/**/*.test.js\"",
    "preview": "npm run build && npm start",
    "deploy": "npm run build && wrangler deploy",
    "start:worker": "npm run build && wrangler dev",
    "newsletter": "node scripts/send.js",
    "og": "node scripts/og.js"
  },
  "dependencies": {
    "@transclude/core": "file:..",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "parse5": "^8.0.1",
    "typescript": "^7.0",
    "vite": "^8.1.5",
    "wrangler": "^4"
  }
}
